# Local .terraform directory containing provider plugins and modules
.terraform/

# Terraform state files (contain sensitive data in plain text)
*.tfstate
*.tfstate.*

# Crash logs
crash.log

# Variables files that may contain secrets
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Credentials files (like the GCP JSON key you generated)
*.json

# CLI configuration file
.terraformrc
terraform.rc