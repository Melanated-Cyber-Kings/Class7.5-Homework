# Created by https://www.toptal.com/developers/gitignore/api/terraform,ssh,dotfilessh,macos,datarecovery,crashlytics,dotenv,visualstudiocode
# Edit at https://www.toptal.com/developers/gitignore?templates=terraform,ssh,dotfilessh,macos,datarecovery,crashlytics,dotenv,visualstudiocode

# Added additional files from other gitignore templates. So this is a combination of multiple templates to cover all the bases for a Terraform project that may also include local development and credentials.



# Terraform working directories
.terraform/
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Terraform plan files
*.tfplan
*.plan
plan.out

# Variable files (often sensitive)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Keep examples
!terraform.tfvars.example
!*.tfvars.example
!*.tfvars.sample

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc
terraform.rc.backup

# LOGS / CRASH FILES

crash.log
crash.*.log
*.log
*.tmp
*.bak

# Crashlytics
crashlytics-build.properties
com_crashlytics_export_strings.xml
crashlytics.properties
fabric.properties

# GCP /Google Cloud SDK

# Realistically these should not be in a repository anyway. 
.gcloud/
.config/gcloud/ 
.config/gcloud/credentials
.config/gcloud/configurations
.config/gcloud/active_config
.config/gcloud/legacy_credentials
.config/gcloud/legacy_credentials/*


# Service account / auth files
*gcp-key*.json
*service-account*.json
*credentials*.json
*adc.json
account.json
key.json

# Generic JSON ignore (protect creds)
# *.json

# Allow common dev JSON manifests
!package.json
!package-lock.json
!composer.json
!tsconfig.json
!settings.json

# Environment variable files (often sensitive)

.env
.env.*
!.env.example

# SSH keys and known hosts (sensitive)
# This is a non-standard location for SSH keys, but
# I have seen them show up in some repositories before.

**/.ssh/id_*
**/.ssh/*_id_*
**/.ssh/known_hosts

# Local patching / temp source
local-patch
patched-src

# MacOS 
# These are some common files that end up in repositories especially
# if they are using an external drive that is not APFS formatted.

.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
*.icloud

# Visual Studio Code
# I don't see these in the repository too often.


.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

.history/
.history
.ionide
*.vsix

# IDEs and editors

.idea/
*.swp
*.swo
Thumbs.db

# DATA RECOVERY / ARCHIVES
$ Mainly see these in archival repositories, especially in in home labs.

*.ecc
*.par
*.par2
*.tar
*.gz2

# Repository specific overrides
# This is to ensure that the main Terraform files and README are included, even 
# if they match some of the ignore patterns above.
# Need to explicitly allow .tf files and README.md since we are ignoring all .json files 
# and some .tfvars files which may be common in Terraform projects.

# This is a experiment trying to get better with gitignore pattern matching.
# The toptotal website and github/gitignore has a lot of good patterns.

# !*.tf
# !README.md